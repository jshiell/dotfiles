{
  "meta": {
    "name": "claude-code-local",
    "description": "Claude Code with Java/Gradle development support",
    "author": "Jamie Shiell"
  },
  "extends": "nolabs-ai/claude",
  "groups": {
    "include": ["java_runtime"]
  },
  "filesystem": {
    "allow_file": [
      "$HOME/dotfiles/gitconfig"
    ],
    "read": [
        "$HOME/.config/ccstatusline"
    ],
    "allow": [
      "$HOME/.config/gh",
      "$HOME/.local/share/mise",
      "$HOME/.agents/skills",
      "$HOME/.gradle",
      "$HOME/.m2",
      "$HOME/dotfiles/agents",
      "/Volumes"
    ],
    "suppress_save_prompt": [
      "/System",
      "/Users",
      "$HOME"
    ]
  }
}
