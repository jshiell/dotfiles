{
  "meta": {
    "name": "claude-code-local",
    "description": "Claude Code with Java/Gradle development support",
    "author": "Jamie Shiell"
  },
  "extends": "claude-code",
  "groups": {
    "include": ["java_runtime"]
  },
  "filesystem": {
    "allow": [
      "$HOME/.config/gh",
      "$HOME/.local/share/mise",
      "$HOME/.agents/skills",
      "$HOME/.gradle",
      "$HOME/.m2",
      "$HOME/dotfiles/agents",
      "/Volumes"
    ]
  }
}
